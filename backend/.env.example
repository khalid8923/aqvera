# AQVERA Backend Configuration
# Copy this file to `.env` and fill in values. Never commit `.env`.

# Application
APP_NAME=AQVERA
APP_ENV=development
DEBUG=true

# Server
HOST=127.0.0.1
PORT=8000

# Database (SQLite for Phase 1, PostgreSQL target)
DATABASE_URL=sqlite:///./aqvera.db

# Security
# Generate a strong secret for production: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=dev-secret-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS
CORS_ORIGINS=["http://localhost:3000"]

# --- AI Provider Credentials (NOT CONFIGURED by default) ---
# Add at least one provider key to enable live AI features (tutor, RAG, assessment,
# course generation). Without a key, providers report "NOT CONFIGURED" and AI
# features degrade to an honest unavailable state.

# OpenAI-compatible (OpenAI, OpenRouter, Groq, NVIDIA, etc.)
AQVERA_OPENAI_COMPATIBLE_API_KEY=
AQVERA_OPENAI_COMPATIBLE_ENDPOINT=https://api.openai.com/v1

# Anthropic (Claude)
AQVERA_ANTHROPIC_API_KEY=
AQVERA_ANTHROPIC_ENDPOINT=https://api.anthropic.com

# --- Cost Control (optional, in USD) ---
# AQVERA_MAX_DAILY_USD=5.00
# AQVERA_MAX_MONTHLY_USD=50.00

# Note: Spending ceilings must ALSO be configured in each provider's official
# dashboard. AQVERA local estimates are not a hard financial guarantee.

# --- Email / SMTP Configuration (NOT CONFIGURED by default) ---
# Password reset and email verification tokens are generated by the API but are
# NOT delivered unless SMTP is configured. When SMTP is not configured, tokens
# are not returned via API responses (to avoid leaking them) and the email
# service reports "not_configured".
#
# To enable email delivery, set SMTP_HOST, SMTP_PORT, SMTP_USER, SMTP_PASS,
# and SMTP_FROM. Leave unset to keep email workflows in "architecture ready"
# state without sending any email.

# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-smtp-user
# SMTP_PASS=your-smtp-password
# SMTP_FROM=noreply@aqvera.local
# SMTP_USE_TLS=true
